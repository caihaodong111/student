# 复制为 .env 后填写真实配置；不要提交 .env。
# Docker 部署时，DB_HOST 必须是容器可访问的数据库地址。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=punch_app
DB_PASSWORD=replace_with_your_database_password
DB_NAME=student
DB_CHARSET=utf8mb4

DB_POOL_MAX_CONNECTIONS=100
DB_POOL_MIN_CACHED=3
DB_POOL_ACQUIRE_TIMEOUT=10

# 与前端开发环境默认 API 端口保持一致。
PORT=5001
FLASK_HOST=0.0.0.0
FLASK_DEBUG=0
RELOGIN_AFTER_DAYS=7

APP_LOG_LEVEL=INFO
REQUEST_LOG_ENABLED=1
